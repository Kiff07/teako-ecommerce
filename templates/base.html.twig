<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#fdfaf4">
    <meta name="csrf-token" content="{{ csrf_token('cart') }}">
    <title>{% block title %}Teako — Gourmet Drinks{% endblock %}</title>
    <meta name="description" content="{% block metaDescription %}Teako Gourmet Drinks — cafés, matchas, smoothies et milkshakes artisanaux à Antananarivo. Goûte et deviens accro !{% endblock %}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%23d05f3a'/><text x='50' y='72' font-size='62' font-family='Georgia' font-style='italic' fill='white' text-anchor='middle'>T</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=Nunito+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cream: { 50: '#fdfaf4', 100: '#faf3e6', 200: '#f3e6cd', 300: '#e9d4ab' },
                        cocoa: { 600: '#7a5a43', 700: '#5f4331', 800: '#4a3426', 900: '#37251b', 950: '#251711' },
                        caramel: { 400: '#d99a3d', 500: '#c77f26', 600: '#a5631b' },
                        terra: { 400: '#e07b54', 500: '#d05f3a', 600: '#b34a2a' },
                        matcha: { 400: '#a3b86c', 500: '#8aa34e' },
                        cream2: '#f7f0e3',
                    },
                    fontFamily: {
                        display: ['"Fraunces"', 'Georgia', 'serif'],
                        body: ['"Nunito Sans"', 'system-ui', 'sans-serif'],
                    },
                },
            },
        };
    </script>
    {{ encore_entry_link_tags('app') }}
    <style>
        /* show correct icon before JS runs */
        html[data-theme='dark'] .theme-btn .sun, html[data-theme='light'] .theme-btn .moon { display: none; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-surface text-ink min-h-screen flex flex-col" data-controller="cart">
<div id="scroll-progress"></div>

{% block bodyTop %}{% endblock %}

{# ---- cart drawer ---- #}
<div data-cart-target="drawerBackdrop" data-cart-backdrop class="overlay hidden opacity-0 transition-opacity" style="animation:none"></div>
<aside data-cart-target="drawer" class="drawer" aria-label="Panier" role="dialog" aria-modal="true">
    <div class="flex items-center justify-between px-5 py-4 border-b divider">
        <h2 class="font-display text-xl flex items-center gap-2">
            <svg class="w-5 h-5 text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
            Votre panier
            <span class="text-sm font-body font-bold text-faint" data-cart-target="drawerCount">0</span>
        </h2>
        <button data-close-cart aria-label="Fermer" class="w-9 h-9 grid place-items-center rounded-full btn-ghost">✕</button>
    </div>

    <div data-cart-target="drawerLines" class="flex-1 overflow-y-auto px-5"></div>

    <div data-cart-target="drawerEmpty" class="flex-1 hidden flex-col items-center justify-center gap-3 px-8 text-center">
        <div class="w-24 h-24 rounded-full grid place-items-center bg-surface-3 text-4xl" aria-hidden="true">🥤</div>
        <p class="font-display text-lg">Votre panier est vide</p>
        <p class="text-sm text-soft">Ajoutez une gourmandise glacée ou un café fumant…</p>
        <a href="{{ path('menu') }}" data-close-cart class="btn-accent mt-2 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-bold">Voir la carte</a>
    </div>

    <div data-cart-target="drawerFooter" class="border-t divider px-5 py-4 space-y-3 bg-surface-2/70">
        <div class="flex items-center justify-between text-sm">
            <span class="text-soft font-semibold">Sous-total</span>
            <span class="font-extrabold text-xl tabular-nums" data-cart-target="drawerTotal">0 Ar</span>
        </div>
        <p class="text-[11px] text-faint leading-snug">Retrait au bar gratuit · Livraison Antananarivo selon la zone.</p>
        <div class="flex gap-2">
            <a href="{{ path('cart_show') }}" data-close-cart class="btn-ghost flex-1 grid place-items-center rounded-full py-2.5 text-sm font-bold">Voir le panier</a>
            <a href="{{ path('order_checkout') }}" data-close-cart class="btn-accent flex-[1.4] grid place-items-center rounded-full py-2.5 text-sm font-bold">Commander</a>
        </div>
    </div>
</aside>

{# ---- announcement bar ---- #}
<div class="relative text-center text-[11px] sm:text-xs font-bold tracking-[0.12em] uppercase px-4 py-2 text-cream-100" style="background:linear-gradient(90deg,#37251b,#5f4331,#37251b)">
    <span class="opacity-90">{{ shop_settings().banner_text }}</span>
</div>

{# ---- header ---- #}
<header class="sticky top-0 z-50 backdrop-blur-xl bg-surface/85 border-b divider">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 gap-3" data-controller="menu">
            {# burger #}
            <button type="button" class="lg:hidden w-10 h-10 -ml-2 grid place-items-center rounded-xl btn-ghost" data-action="menu#toggle" aria-label="Ouvrir le menu">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
            </button>

            {# logo #}
            <a href="{{ path('home') }}" class="flex items-center gap-2.5 shrink-0" aria-label="Teako — retour à l'accueil">
                <span class="relative w-10 h-10 rounded-2xl grid place-items-center text-white shadow-md" style="background:linear-gradient(135deg,var(--gold),var(--accent))">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 14c1.5-3.2 5-5 8.5-4.3M9.5 13.5c.3-2.4 1.8-4.3 4-5M4 19h16"/><path d="M6.5 11.5c-.3 2 .5 3.6 2.2 4.4 3 1.4 6.3-.2 7.8-3 1.5-2.8 1.1-6-1-8.2"/></svg>
                </span>
                <span class="leading-none">
                    <span class="block font-display font-bold text-[1.35rem] tracking-tight">Teako</span>
                    <span class="block text-[8px] font-black tracking-[0.32em] uppercase text-[var(--ink-faint)]">Gourmet Drinks</span>
                </span>
            </a>

            {# desktop nav #}
            <nav class="hidden lg:flex items-center gap-7 text-sm font-bold" aria-label="Navigation principale">
                <a href="{{ path('home') }}" class="nav-link {{ app.current_route == 'home' ? 'active text-[var(--accent)]' : 'hover:text-[var(--accent)] transition-colors' }}">Accueil</a>
                <a href="{{ path('menu') }}" class="nav-link {{ app.current_route in ['menu','product_show','category_show'] ? 'active text-[var(--accent)]' : 'hover:text-[var(--accent)] transition-colors' }}">La carte</a>
                <a href="{{ path('discover') }}" class="nav-link {{ app.current_route == 'discover' ? 'active text-[var(--accent)]' : 'hover:text-[var(--accent)] transition-colors' }}">Nos best-sellers</a>
                <a href="{{ path('about') }}" class="nav-link {{ app.current_route == 'about' ? 'active text-[var(--accent)]' : 'hover:text-[var(--accent)] transition-colors' }}">Notre histoire</a>
                <a href="{{ path('contact') }}" class="nav-link {{ app.current_route == 'contact' ? 'active text-[var(--accent)]' : 'hover:text-[var(--accent)] transition-colors' }}">Contact</a>
            </nav>

            {# actions #}
            <div class="flex items-center gap-1 sm:gap-1.5 ml-auto">
                <a href="{{ path('fav_list') }}" class="relative w-10 h-10 grid place-items-center rounded-xl text-soft hover:bg-surface-2 transition-colors" aria-label="Mes favoris">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 20.6S4 15.7 2.4 11.7C1 8.2 3 4.9 6.3 4.6c2-.2 3.8.9 4.7 2.5h2c.9-1.6 2.7-2.7 4.7-2.5 3.3.3 5.3 3.6 3.9 7.1C20 15.7 12 20.6 12 20.6z"/></svg>
                    <span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-[var(--negative)]"></span>
                </a>
                <div data-controller="theme" class="w-10 h-10">
                    <button type="button" data-theme-target="button" data-action="theme#toggle" class="theme-btn w-10 h-10 grid place-items-center rounded-xl text-soft hover:bg-surface-2 transition-colors" aria-label="Basculer le thème">
                        <svg class="moon w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.6 14.2A8.5 8.5 0 0 1 9.8 3.4a8.5 8.5 0 1 0 10.8 10.8z"/></svg>
                        <svg class="sun w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/></svg>
                    </button>
                </div>
                <div class="w-10 h-10">
                    <button type="button" data-open-cart data-cart-target="badgeWrap" class="hidden relative w-10 h-10 grid place-items-center rounded-xl text-soft hover:bg-surface-2 transition-colors" aria-label="Ouvrir le panier">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M6 7h12l1.2 13.2a1.5 1.5 0 0 1-1.5 1.6H6.3a1.5 1.5 0 0 1-1.5-1.6L6 7z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
                        <span data-cart-target="badgeCount" class="absolute -top-1 -right-1 min-w-[19px] h-[19px] px-1 grid place-items-center rounded-full text-[10px] font-black text-white" style="background:var(--accent)">0</span>
                    </button>
                </div>
            </div>

            {# mobile menu panel #}
            <div data-menu-target="backdrop" class="fixed inset-0 z-50 bg-black/40 hidden lg:hidden" data-action="click->menu#close"></div>
            <div data-menu-target="panel" class="fixed top-0 left-0 bottom-0 z-50 w-[86vw] max-w-xs bg-surface border-r divider -translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] flex flex-col lg:hidden">
                <div class="flex items-center justify-between px-5 py-4 border-b divider">
                    <span class="font-display font-bold text-lg">Menu</span>
                    <button type="button" class="w-9 h-9 grid place-items-center rounded-full btn-ghost" data-action="menu#close" aria-label="Fermer">✕</button>
                </div>
                <nav class="flex-1 overflow-y-auto px-4 py-3 space-y-1 text-[15px] font-bold">
                    <a href="{{ path('home') }}" data-action="menu#close" class="block px-3 py-2.5 rounded-xl hover:bg-surface-2">Accueil</a>
                    <a href="{{ path('menu') }}" data-action="menu#close" class="block px-3 py-2.5 rounded-xl hover:bg-surface-2">La carte</a>
                    <a href="{{ path('discover') }}" data-action="menu#close" class="block px-3 py-2.5 rounded-xl hover:bg-surface-2">Nos best-sellers</a>
                    <a href="{{ path('about') }}" data-action="menu#close" class="block px-3 py-2.5 rounded-xl hover:bg-surface-2">Notre histoire</a>
                    <a href="{{ path('contact') }}" data-action="menu#close" class="block px-3 py-2.5 rounded-xl hover:bg-surface-2">Contact</a>
                    <div class="pt-3 mt-3 border-t divider space-y-2">
                        <p class="px-3 text-[10px] font-black uppercase tracking-[0.2em] text-faint">Catégories</p>
                        {% for cat in store_categories() %}
                            {% if cat.products|length > 0 %}
                            <a href="{{ path('category_show', { slug: cat.slug }) }}" data-action="menu#close" class="block px-3 py-2 rounded-xl text-sm font-bold text-soft hover:bg-surface-2">{{ cat.name }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </nav>
                <div class="px-5 py-4 border-t divider text-[11px] text-faint leading-relaxed">
                    Lot IBF 9 Antsahavola · Antananarivo<br>Goûte et deviens accro !
                </div>
            </div>
        </div>
    </div>
</header>

<main class="flex-1">
    {% block body %}{% endblock %}
</main>

{# ---- footer ---- #}
<footer class="mt-20 border-t divider" style="background:var(--surface-2)">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
        <div class="space-y-4">
            <a href="{{ path('home') }}" class="flex items-center gap-2.5">
                <span class="w-9 h-9 rounded-xl grid place-items-center text-white" style="background:linear-gradient(135deg,var(--gold),var(--accent))">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 14c1.5-3.2 5-5 8.5-4.3M9.5 13.5c.3-2.4 1.8-4.3 4-5M4 19h16"/><path d="M6.5 11.5c-.3 2 .5 3.6 2.2 4.4 3 1.4 6.3-.2 7.8-3 1.5-2.8 1.1-6-1-8.2"/></svg>
                </span>
                <span class="leading-none">
                    <span class="font-display font-bold text-xl block">Teako</span>
                    <span class="text-[8px] font-black tracking-[0.3em] uppercase text-faint">Gourmet Drinks</span>
                </span>
            </a>
            <p class="text-sm text-soft leading-relaxed">Cafés de spécialité, thés, matchas, smoothies &amp; milkshakes artisanaux préparés avec amour à Antananarivo.</p>
            <p class="text-sm italic font-display text-[var(--accent)]">« Goûte et deviens accro ! »</p>
        </div>

        <div>
            <h4 class="font-black text-[11px] uppercase tracking-[0.18em] text-faint mb-4">Navigation</h4>
            <ul class="space-y-2.5 text-sm font-semibold text-soft">
                <li><a href="{{ path('home') }}" class="hover:text-[var(--accent)] transition-colors">Accueil</a></li>
                <li><a href="{{ path('menu') }}" class="hover:text-[var(--accent)] transition-colors">La carte</a></li>
                <li><a href="{{ path('discover') }}" class="hover:text-[var(--accent)] transition-colors">Best-sellers</a></li>
                <li><a href="{{ path('about') }}" class="hover:text-[var(--accent)] transition-colors">Notre histoire</a></li>
                <li><a href="{{ path('contact') }}" class="hover:text-[var(--accent)] transition-colors">Contact</a></li>
                <li><a href="{{ path('cart_show') }}" class="hover:text-[var(--accent)] transition-colors">Mon panier</a></li>
            </ul>
        </div>

        <div>
            <h4 class="font-black text-[11px] uppercase tracking-[0.18em] text-faint mb-4">Catégories</h4>
            <ul class="space-y-2.5 text-sm font-semibold text-soft">
                {% for cat in store_categories() %}
                <li><a href="{{ path('category_show', { slug: cat.slug }) }}" class="hover:text-[var(--accent)] transition-colors">{{ cat.name }}</a></li>
                {% endfor %}
            </ul>
        </div>

        <div>
            <h4 class="font-black text-[11px] uppercase tracking-[0.18em] text-faint mb-4">Nous trouver</h4>
            <address class="not-italic text-sm text-soft space-y-2.5">
                <p class="flex gap-2"><span aria-hidden="true">📍</span> {{ shop_settings().address }}</p>
                <p class="flex gap-2"><span aria-hidden="true">📞</span> {{ shop_settings().phone }}</p>
                <p class="flex gap-2"><span aria-hidden="true">✉️</span> {{ shop_settings().email }}</p>
            </address>
            {# ---- réseaux sociaux ---- #}
            {% set settings = shop_settings() %}
            <div class="flex items-center gap-2.5 mt-5">
                
                {# Facebook #}
                {% if settings.facebook %}
                <a href="{{ settings.facebook }}" target="_blank" rel="noopener noreferrer"
                   class="group w-10 h-10 rounded-full bg-surface-3 ring-1 ring-line grid place-items-center text-soft hover:text-white hover:bg-[#1877F2] hover:ring-[#1877F2] hover:scale-110 active:scale-95 transition-all duration-200 shadow-sm"
                   aria-label="Facebook" title="Rejoignez-nous sur Facebook">
                    <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                </a>
                {% endif %}

                {# Instagram #}
                {% if settings.instagram %}
                <a href="{{ settings.instagram }}" target="_blank" rel="noopener noreferrer"
                   class="group w-10 h-10 rounded-full bg-surface-3 ring-1 ring-line grid place-items-center text-soft hover:text-white hover:bg-gradient-to-tr hover:from-[#f09433] hover:via-[#dc2743] hover:to-[#bc1888] hover:ring-transparent hover:scale-110 active:scale-95 transition-all duration-200 shadow-sm"
                   aria-label="Instagram" title="Suivez-nous sur Instagram">
                    <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                </a>
                {% endif %}

                {# TikTok #}
                {% if settings.tiktok %}
                <a href="{{ settings.tiktok }}" target="_blank" rel="noopener noreferrer"
                   class="group w-10 h-10 rounded-full bg-surface-3 ring-1 ring-line grid place-items-center text-soft hover:text-white hover:bg-black hover:ring-black hover:scale-110 active:scale-95 transition-all duration-200 shadow-sm"
                   aria-label="TikTok" title="Découvrez nos vidéos TikTok">
                    <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                        <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.97v7.62c0 1.93-.45 3.86-1.45 5.51-1.25 2.05-3.32 3.56-5.69 4.09-2.38.53-4.94.13-7-.99-2.07-1.12-3.66-3.03-4.36-5.28-.7-2.25-.49-4.75.56-6.84 1.05-2.09 2.95-3.65 5.25-4.28 1.02-.28 2.08-.38 3.14-.3v4.06c-1.15-.09-2.33.22-3.21.94-.88.72-1.39 1.83-1.36 2.97.03 1.14.63 2.21 1.57 2.87.94.66 2.16.8 3.25.43 1.09-.37 1.95-1.33 2.22-2.45.14-.58.19-1.18.19-1.78V.02z"/>
                    </svg>
                </a>
                {% endif %}

                {# WhatsApp direct #}
                {% if settings.whatsapp %}
                {% set waClean = settings.whatsapp|replace({' ': '', '+': '', '-': ''}) %}
                <a href="https://wa.me/{{ waClean }}" target="_blank" rel="noopener noreferrer"
                   class="group w-10 h-10 rounded-full bg-surface-3 ring-1 ring-line grid place-items-center text-soft hover:text-white hover:bg-[#25D366] hover:ring-[#25D366] hover:scale-110 active:scale-95 transition-all duration-200 shadow-sm"
                   aria-label="WhatsApp" title="Discuter directement sur WhatsApp">
                    <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
