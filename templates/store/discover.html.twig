{% extends 'base.html.twig' %}

{% block title %}Nos best-sellers — Teako Gourmet Drinks{% endblock %}

{% block body %}
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 lg:pt-16 pb-24">
    <nav aria-label="Fil d'Ariane" class="text-xs font-bold text-faint mb-6">
        <a href="{{ path('home') }}" class="hover:text-[var(--accent)]">Accueil</a>
        <span class="mx-2">/</span><span>Nos best-sellers</span>
    </nav>

    <div data-reveal>
        <p class="text-[11px] font-black uppercase tracking-[0.24em]" style="color:var(--accent)">Les plus commandés</p>
        <h1 class="font-display font-semibold text-5xl sm:text-6xl mt-2 text-balance">Ceux qui rendent <em class="italic">accro</em></h1>
        <p class="mt-4 max-w-2xl text-soft text-lg">Classés par nombre de commandes passées chez Teako. La preuve par les chiffres.</p>
    </div>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-7" data-stagger-grid>
        {% for product in products %}
            {{ include('components/product_card.html.twig', { product: product }) }}
        {% endfor %}
    </div>
</section>
{% endblock %}
