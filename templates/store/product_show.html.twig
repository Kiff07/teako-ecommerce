{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — Teako Gourmet Drinks{% endblock %}

{% set cover = product.cover %}
{% set hasImg = images|length > 0 %}

{% block body %}
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 pb-20" data-cart-page>
    <nav aria-label="Fil d'Ariane" class="flex flex-wrap items-center gap-2 text-xs font-bold text-faint mb-7">
        <a href="{{ path('home') }}" class="crumb-enter hover:text-[var(--accent)]" style="--i:0">Accueil</a>
        <span class="crumb-enter" style="--i:1">/</span>
        <a href="{{ path('menu') }}" class="crumb-enter hover:text-[var(--accent)]" style="--i:1">La carte</a>
        {% if product.category %}
        <span class="crumb-enter" style="--i:2">/</span>
        <a href="{{ path('category_show', { slug: product.category.slug }) }}" class="crumb-enter hover:text-[var(--accent)]" style="--i:2">{{ product.category.name }}</a>
        {% endif %}
        <span class="crumb-enter" style="--i:3">/</span>
        <span class="crumb-enter text-ink" style="--i:4">{{ product.name }}</span>
    </nav>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">

        {# ================= GALLERY ================= #}
        <div data-controller="gallery" class="lg:sticky lg:top-24">
            <div class="relative rounded-[2rem] overflow-hidden ring-line bg-surface-2 aspect-[4/5] max-h-[78vh] gallery-main select-none"
                 data-gallery-target="stage" style="cursor:zoom-in">

                {% for image in images %}
                <div class="gallery-slide {{ loop.first ? 'active' : '' }}">
                    {% set img = image|product_image_data('big') %}
                    <img src="{{ img.url }}"
                         data-real
                         data-full="{{ image|product_image('big') }}"
                         data-zoom="{{ image|product_image_original }}"
                         alt="{{ image.altText ?? product.name }}"
                         loading="{{ loop.first ? 'eager' : 'lazy' }}"
                         fetchpriority="{{ loop.first ? 'high' : 'auto' }}"
                         class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent pointer-events-none"></div>
                </div>
                {% else %}
                <div class="gallery-slide active">
                    <div class="w-full h-full grid place-items-center" style="background:linear-gradient(140deg,var(--surface-3),var(--surface-2))">
                        <span class="font-display text-9xl italic opacity-30">{{ product.name|first|upper }}</span>
                    </div>
                </div>
                {% endfor %}

                {# zoom lens #}
                <div data-gallery-target="lens" class="zoom-lens" role="presentation"></div>

                {# top chips #}
                {% if product.tag %}
                <span class="absolute top-4 left-4 z-10 px-3.5 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest text-white shadow" style="background:linear-gradient(120deg,var(--gold),var(--accent))">{{ product.tag }}</span>
                {% endif %}
                {% if product.isOutOfStock %}
                <span class="absolute top-4 left-1/2 -translate-x-1/2 z-10 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-white text-cocoa-900 shadow">Rupture</span>
                {% endif %}

                <div class="absolute top-3.5 right-3.5 z-10 flex gap-2">
                    {{ include('components/fav_btn.html.twig', { product: product, style: 'overlay' }) }}
                    {% if hasImg %}
                    <button type="button" data-action="gallery#openLightbox" class="w-9 h-9 grid place-items-center rounded-full bg-white/90 text-cocoa-800 shadow backdrop-blur-sm hover:scale-110 transition-transform" aria-label="Plein écran">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/></svg>
                    </button>
                    {% endif %}
                </div>

                {# arrows #}
                {% if images|length > 1 %}
                <button type="button" data-action="gallery#prev" class="absolute left-3 top-1/2 -translate-y-1/2 z-10 w-10 h-10 grid place-items-center rounded-full bg-white/90 text-cocoa-900 shadow-lg hover:scale-110 transition-transform" aria-label="Image précédente">‹</button>
                <button type="button" data-action="gallery#next" class="absolute right-3 top-1/2 -translate-y-1/2 z-10 w-10 h-10 grid place-items-center rounded-full bg-white/90 text-cocoa-900 shadow-lg hover:scale-110 transition-transform" aria-label="Image suivante">›</button>
                <span class="absolute bottom-3.5 right-3.5 z-10 px-3 py-1 rounded-full bg-black/45 text-white text-xs font-bold backdrop-blur-sm" data-gallery-target="count">{{ 1 }} / {{ images|length }}</span>
                {% endif %}
            </div>

            {# thumbnails #}
            {% if images|length > 1 %}
            <div class="mt-4 grid grid-cols-4 sm:grid-cols-5 gap-3">
                {% for image in images %}
                {% set t = image|product_image_data('thumb') %}
                <button type="button" data-gallery-target="thumb" data-i="{{ loop.index0 }}" data-action="gallery#pick"
                        class="thumb relative aspect-square rounded-2xl overflow-hidden ring-line bg-surface-3 {{ loop.first ? 'active' : '' }}"
                        aria-label="Voir l'image {{ loop.index }}"
                        aria-current="{{ loop.first ? 'true' : 'false' }}">
                    <img src="{{ t.url }}" alt="{{ image.altText ?? '' }}" loading="lazy" class="w-full h-full object-cover">
                </button>
                {% endfor %}
            </div>
            {% endif %}

            {# lightbox #}
            <div data-gallery-target="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Visionneuse plein écran">
                <button type="button" data-action="gallery#closeLightbox" class="absolute top-5 right-5 w-11 h-11 rounded-full bg-white/10 text-white text-xl hover:bg-white/25 transition-colors" aria-label="Fermer">✕</button>
                {% if images|length > 1 %}
                <button type="button" data-action="gallery#prev" class="absolute left-4 sm:left-8 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 text-white text-2xl hover:bg-white/25" aria-label="Précédente">‹</button>
                <button type="button" data-action="gallery#next" class="absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 text-white text-2xl hover:bg-white/25" aria-label="Suivante">›</button>
                {% endif %}
                <img data-gallery-target="lightboxImg" src="" alt="" class="anim-scale-in">
            </div>
        </div>

        {# ================= INFO PANEL ================= #}
        <div data-reveal>
            <p class="text-[11px] font-black uppercase tracking-[0.24em]" style="color:var(--accent)">
                {{ product.category.name|default('Teako') }} · commandé {{ product.salesCount }} fois
            </p>
            <h1 class="font-display font-semibold text-4xl sm:text-5xl mt-2 leading-[1.05]">{{ product.name }}</h1>

            <div class="flex flex-wrap items-center gap-3 mt-4">
                <span class="font-display font-bold text-4xl tabular-nums" style="color:var(--accent)">{{ product.priceCents|money }}</span>
                <span class="px-3 py-1 rounded-full text-xs font-bold
                    {{ product.isOutOfStock ? 'bg-[var(--negative)]/15 text-[var(--negative)]' :
                       (product.stock <= 5 ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300' : 'text-[var(--positive)] bg-[var(--positive)]/10') }}">
                    {% if product.isOutOfStock %}Rupture de stock{% elseif product.stock <= 5 %}Plus que {{ product.stock }} en stock{% else %}En stock{% endif %}
                </span>
            </div>

            <p class="mt-6 text-soft leading-relaxed text-[1.05rem]">{{ product.description }}</p>

            {% if product.recipe %}
            <div class="mt-6 rounded-2xl surface-card p-5">
                <p class="flex items-center gap-2 text-sm font-black uppercase tracking-widest text-[11px]"><span class="text-lg" aria-hidden="true">🧪</span> Dans ce délice</p>
                <p class="mt-2 text-sm text-soft leading-relaxed">{{ product.recipe }}</p>
            </div>
            {% endif %}

            {# quantity + CTA #}
            <div class="mt-8 flex flex-col sm:flex-row items-stretch gap-3" data-qty-wrap data-product-block data-product-id="{{ product.id }}">
                <div class="flex items-center justify-between rounded-full surface-card px-2 h-14 sm:w-36" data-stepper>
                    <button type="button" data-step="minus" class="w-10 h-10 rounded-full grid place-items-center text-xl font-bold text-soft hover:bg-surface-3 disabled:opacity-30" aria-label="Diminuer la quantité">−</button>
                    <input type="number" data-qty value="1" min="1" max="8" inputmode="numeric"
                           class="w-10 bg-transparent text-center font-extrabold tabular-nums focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
                    <button type="button" data-step="plus" class="w-10 h-10 rounded-full grid place-items-center text-xl font-bold text-soft hover:bg-surface-3" aria-label="Augmenter la quantité">+</button>
                </div>

                {% if not product.isOutOfStock %}
                <button type="button" data-add-to-cart data-product-id="{{ product.id }}"
                        class="btn-accent flex-1 inline-flex items-center justify-center gap-3 rounded-full h-14 text-base font-extrabold">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1.5"/><circle cx="19" cy="21" r="1.5"/><path d="M2.5 3h2l2.4 12.2a1.6 1.6 0 0 0 1.6 1.3h9.4a1.6 1.6 0 0 0 1.6-1.3L21.5 7H6"/></svg>
                    <span data-btn-label>Ajouter au panier</span>
                </button>
                {% else %}
                <a href="{{ path('menu') }}" class="btn-ghost flex-1 inline-flex items-center justify-center gap-2 rounded-full h-14 font-bold">Voir d'autres créations</a>
                {% endif %}
            </div>

            <p class="mt-3 text-xs text-faint font-semibold flex items-center gap-2">
                <span aria-hidden="true">⚡</span> Quantité limitée à 8 par commande · paiement à la réception
            </p>

            <div class="mt-7 grid sm:grid-cols-3 gap-3 text-center text-xs font-bold text-soft">
                <div class="rounded-2xl surface-card p-4"><p class="text-2xl mb-1" aria-hidden="true">🚶</p>Retrait bar<br><span class="text-faint font-semibold">gratuit</span></div>
                <div class="rounded-2xl surface-card p-4"><p class="text-2xl mb-1" aria-hidden="true">🛵</p>Livraison<br><span class="text-faint font-semibold">Antananarivo</span></div>
                <div class="rounded-2xl surface-card p-4"><p class="text-2xl mb-1" aria-hidden="true">🧊</p>Préparé<br><span class="text-faint font-semibold">à la commande</span></div>
            </div>
        </div>
    </div>

    {# ============ RECOMMANDÉS ============ #}
    {% if recommended|length > 0 %}
    <section class="mt-24">
        <div class="flex items-end justify-between gap-4" data-reveal>
            <h2 class="font-display font-semibold text-3xl sm:text-4xl">Vous aimerez <em class="italic">aussi</em></h2>
            <a href="{{ path('menu') }}" class="text-sm font-extrabold hidden sm:inline-flex items-center gap-2" style="color:var(--accent)">Toute la carte →</a>
        </div>
        <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6" data-stagger-grid>
            {% for product in recommended %}
                {{ include('components/product_card.html.twig', { product: product }) }}
            {% endfor %}
        </div>
    </section>
    {% endif %}
</section>
{% endblock %}
