<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — Teako Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,400;0,600;0,700;1,500&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    {{ encore_entry_link_tags('app') }}
    <style>body{display:grid;place-items:center;min-height:100vh;padding:1rem}</style>
</head>
<body>
<div class="w-full max-w-md anim-scale-in">
    <div class="rounded-[2rem] surface-card p-8 sm:p-10">
        <div class="flex flex-col items-center text-center mb-8">
            <span class="w-16 h-16 rounded-3xl grid place-items-center text-white mb-4 shadow-lg" style="background:linear-gradient(135deg,var(--gold),var(--accent))">
                <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 14c1.5-3.2 5-5 8.5-4.3M9.5 13.5c.3-2.4 1.8-4.3 4-5M4 19h16"/><path d="M6.5 11.5c-.3 2 .5 3.6 2.2 4.4 3 1.4 6.3-.2 7.8-3 1.5-2.8 1.1-6-1-8.2"/></svg>
            </span>
            <h1 class="font-display font-bold text-3xl">Espace gestionnaire</h1>
            <p class="text-sm text-soft mt-1.5">Teako Gourmet Drinks · Antananarivo</p>
        </div>

        {% if error %}
        <div class="mb-5 rounded-xl px-4 py-3 text-sm font-bold flex items-center gap-2" style="background:rgba(194,69,45,.12);color:var(--negative)">
            Identifiants invalides. Réessayez.
        </div>
        {% endif %}

        <form method="post" action="{{ path('admin_login') }}" class="space-y-5">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <input type="hidden" name="_target_path" value="{{ path('admin_dashboard') }}">
            <div>
                <label class="field-label" for="email">Adresse e-mail</label>
                <input type="email" id="email" name="email" value="{{ last_username }}" required autofocus autocomplete="username" class="field-input" placeholder="admin@teako.mg">
            </div>
            <div>
                <label class="field-label" for="password">Mot de passe</label>
                <input type="password" id="password" name="password" required autocomplete="current-password" class="field-input" placeholder="••••••••">
            </div>
            <button type="submit" class="btn-accent w-full grid place-items-center rounded-xl py-3.5 font-extrabold">Se connecter</button>
        </form>

        <div class="mt-6 rounded-2xl p-4 text-xs text-soft bg-surface-2 leading-relaxed">
            <p class="font-black uppercase tracking-widest text-[9px] text-faint mb-1.5">Compte de démonstration</p>
            admin@teako.mg · teako2026
        </div>
    </div>
    <p class="text-center mt-5 text-xs text-faint"><a href="{{ path('home') }}" class="hover:text-[var(--accent)] font-bold">← Retour à la boutique</a></p>
</div>
</body>
</html>
