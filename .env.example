# Copy to .env (and .env.dev if needed) then adjust values.
# Never commit real secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=CHANGE_ME_32_random_hex_characters
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Used to generate URLs in non-HTTP contexts, such as CLI commands.
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite is the default used by this project (no server required).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/teako.db"
###< doctrine/doctrine-bundle ###
